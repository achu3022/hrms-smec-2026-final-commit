<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<style>
    /* Custom styling for jQuery UI Datepicker to match Tailwind form */
    .ui-widget-header { background: #6366f1; color: white; border: none; }
    .ui-state-default, .ui-widget-content .ui-state-default { background: #f8fafc; border: 1px solid #e2e8f0; color: #334155; border-radius: 4px; }
    .ui-state-active, .ui-widget-content .ui-state-active { background: #4f46e5; border-color: #4f46e5; color: white; }
    .ui-datepicker { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); border: 1px solid #cbd5e1; border-radius: 8px; padding: 0.5em; }
    .pf-card { background:#fff; border:1px solid #e2e8f0; border-radius:16px; padding:24px; margin-bottom:24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); }
    .pf-section-title { font-size:.75rem; font-weight:800; color:#4f46e5; text-transform:uppercase; letter-spacing:.8px; margin-bottom:20px; padding-bottom:12px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; gap:8px; }
    .pf-grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:20px; }
    @media(max-width:768px){ .pf-grid{ grid-template-columns:1fr; } }
    .pf-field { display:flex; flex-direction:column; gap:6px; }
    .form-label { font-size:.75rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.5px; margin-bottom:0; }
    .form-control, .form-select { width:100%; border-radius:10px; border:1px solid #cbd5e1; padding:12px 16px; font-size:0.95rem; color:#334155; background-color:#f8fafc; transition:all 0.2s ease; outline:none; box-sizing: border-box;}
    .form-control:focus, .form-select:focus { border-color:#6366f1; background-color:#fff; box-shadow:0 0 0 4px rgba(99,102,241,0.15); }
    .form-control:disabled { background-color:#e2e8f0; color:#94a3b8; cursor:not-allowed; }
    textarea.form-control { min-height: 100px; resize: vertical; }
    .btn-save { background:linear-gradient(135deg, #6366f1, #4f46e5); color:#fff; font-weight:700; padding:12px 28px; border-radius:10px; border:none; transition:all 0.3s ease; display:inline-flex; align-items:center; gap:8px; font-size: 1rem; cursor: pointer; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4); }
    .btn-save:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.6); }
    .file-input-wrapper { position: relative; overflow: hidden; display: inline-block; width: 100%; }
    .file-input-wrapper input[type=file] { padding: 9px 16px; background: #fff; cursor: pointer; }
    .invalid-feedback { color: #ef4444; font-size: 0.75rem; margin-top: 4px; font-weight: 500; }
    .is-invalid { border-color: #ef4444 !important; background-color: #fef2f2 !important; }
    .dynamic-row { border: 1px solid #eef0f2; padding: 20px; margin-bottom: 15px; border-radius: 12px; position: relative; background-color: #fafbfc; }
    .remove-row { position: absolute; top: 15px; right: 15px; background: #fee2e2; color: #ef4444; border: none; border-radius: 50%; width: 32px; height: 32px; padding: 0; line-height: 32px; text-align: center; cursor: pointer; transition: all 0.2s; }
    .remove-row:hover { background: #fca5a5; color: #b91c1c; }
    .btn-add { background: #fff; color: #4f46e5; border: 1px solid #4f46e5; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; }
    .btn-add:hover { background: #e0e7ff; }
</style>

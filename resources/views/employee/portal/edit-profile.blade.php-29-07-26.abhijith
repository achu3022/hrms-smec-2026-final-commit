<!-- jQuery and jQuery UI JS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
<script>
    function initDatepicker() {
        $('.datepicker').datepicker({
            dateFormat: 'dd-mm-yy',
            changeMonth: true,
            changeYear: true,
            yearRange: "-100:+10"
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Initialize existing datepickers
        initDatepicker();
        let eduIndex = {{ count($employee->education) > 0 ? max(array_keys($employee->education->toArray())) + 1 : 0 }};
        let expIndex = {{ count($employee->experience) > 0 ? max(array_keys($employee->experience->toArray())) + 1 : 0 }};
        let certIndex = {{ count($employee->certificates) > 0 ? max(array_keys($employee->certificates->toArray())) + 1 : 0 }};

        document.getElementById('addEducation').addEventListener('click', function() {
            let html = `
            <div class="dynamic-row">
                <button type="button" class="remove-row"><i class="fa-solid fa-times"></i></button>
                <div class="pf-grid">
                    <div class="pf-field"><label class="form-label">Qualification</label><input type="text" name="education[${eduIndex}][qualification]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">Course</label><input type="text" name="education[${eduIndex}][course]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">Institution</label><input type="text" name="education[${eduIndex}][institution]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">University / Board</label><input type="text" name="education[${eduIndex}][university]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">Passing Year</label><input type="text" name="education[${eduIndex}][year]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">% / CGPA</label><input type="text" name="education[${eduIndex}][percentage]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">Upload Certificate</label><input type="file" name="education[${eduIndex}][certificate]" class="form-control" accept="image/*,.pdf"></div>
                </div>
            </div>`;
            document.getElementById('educationContainer').insertAdjacentHTML('beforeend', html);
            eduIndex++;
        });

        document.getElementById('addExperience').addEventListener('click', function() {
            let html = `
            <div class="dynamic-row">
                <button type="button" class="remove-row"><i class="fa-solid fa-times"></i></button>
                <div class="pf-grid">
                    <div class="pf-field"><label class="form-label">Company Name</label><input type="text" name="experience[${expIndex}][company]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">Designation</label><input type="text" name="experience[${expIndex}][designation]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">From Date</label><input type="text" name="experience[${expIndex}][from_date]" class="form-control datepicker" placeholder="DD-MM-YYYY" autocomplete="off"></div>
                    <div class="pf-field"><label class="form-label">To Date</label><input type="text" name="experience[${expIndex}][to_date]" class="form-control datepicker" placeholder="DD-MM-YYYY" autocomplete="off"></div>
                    <div class="pf-field"><label class="form-label">Total Years</label><input type="text" name="experience[${expIndex}][years]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">Upload Certificate</label><input type="file" name="experience[${expIndex}][certificate]" class="form-control" accept="image/*,.pdf"></div>
                </div>
            </div>`;
            document.getElementById('experienceContainer').insertAdjacentHTML('beforeend', html);
            initDatepicker();
            expIndex++;
        });

        document.getElementById('addCertificate').addEventListener('click', function() {
            let html = `
            <div class="dynamic-row">
                <button type="button" class="remove-row"><i class="fa-solid fa-times"></i></button>
                <div class="pf-grid">
                    <div class="pf-field"><label class="form-label">Certificate Name</label><input type="text" name="certificates[${certIndex}][certificate_name]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">Issued By</label><input type="text" name="certificates[${certIndex}][issued_by]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">Issued Date</label><input type="text" name="certificates[${certIndex}][issued_date]" class="form-control datepicker" placeholder="DD-MM-YYYY" autocomplete="off"></div>
                    <div class="pf-field"><label class="form-label">Expiry Date</label><input type="text" name="certificates[${certIndex}][expiry_date]" class="form-control datepicker" placeholder="DD-MM-YYYY" autocomplete="off"></div>
                    <div class="pf-field"><label class="form-label">Upload Certificate</label><input type="file" name="certificates[${certIndex}][file]" class="form-control" accept="image/*,.pdf"></div>
                </div>
            </div>`;
            document.getElementById('certificateContainer').insertAdjacentHTML('beforeend', html);
            initDatepicker();
            certIndex++;
        });

        let assetIndex = {{ count($employee->assetAssignments) > 0 ? max(array_keys($employee->assetAssignments->toArray())) + 1 : 0 }};
        
        document.getElementById('addAsset').addEventListener('click', function() {
            let html = `
            <div class="dynamic-row">
                <button type="button" class="remove-row"><i class="fa-solid fa-times"></i></button>
                <div class="pf-grid">
                    <div class="pf-field"><label class="form-label">Asset Name</label><input type="text" name="assets[${assetIndex}][name]" class="form-control"></div>
                    <div class="pf-field"><label class="form-label">Type</label><input type="text" name="assets[${assetIndex}][type]" class="form-control" placeholder="Laptop, PC, Phone, etc."></div>
                    <div class="pf-field"><label class="form-label">Serial Number</label><input type="text" name="assets[${assetIndex}][serial_number]" class="form-control"></div>
                </div>
            </div>`;
            document.getElementById('assetContainer').insertAdjacentHTML('beforeend', html);
            assetIndex++;
        });

        document.addEventListener('click', function(e) {
            if(e.target && (e.target.matches('.remove-row') || e.target.closest('.remove-row'))) {
                e.target.closest('.dynamic-row').remove();
            }
        });


    });
</script>
@endpush

@endsection
